{
  "name": "cities",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "wrangler d1 migrations apply cities --local",
    "build": "tsc -b && vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "check:roads": "node scripts/check-roads.mjs",
    "check:street": "node scripts/check-roads.mjs scripts/check-street.ts && node scripts/check-roads.mjs scripts/check-street-interaction.ts && node scripts/check-roads.mjs scripts/check-joystick.ts",
    "check:decorations": "node scripts/check-roads.mjs scripts/check-decorations.ts && node scripts/check-decorations-db.mjs",
    "check:grid": "node scripts/check-roads.mjs scripts/check-grid.ts",
    "prebuild": "node scripts/changelog.mjs draft",
    "changelog:draft": "node scripts/changelog.mjs draft",
    "changelog:approve": "node scripts/changelog.mjs approve",
    "check:neighbors": "node scripts/check-roads.mjs scripts/check-owned-neighbors.ts",
    "check:shops": "node scripts/check-roads.mjs scripts/check-attached-shops.ts",
    "check:lighting": "node scripts/check-roads.mjs scripts/check-lighting.ts",
    "check:rendering": "node scripts/check-roads.mjs scripts/check-rendering.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "9.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "shell-quote": "^1.11.0"
  }
}
